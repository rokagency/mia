# Production environment for Deskia.
#
# On the droplet:
#   cp .env.production.example .env.production
#   nano .env.production    # fill in REAL values, never commit this file
#
# Do NOT commit .env.production — it's gitignored. The file lives only
# on the droplet.

# ── OpenAI ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-REPLACE-WITH-REAL-KEY
OPENAI_MODEL=gpt-4o-mini

# ── Postgres ────────────────────────────────────────────────────────────
# Pick a strong password (e.g. `openssl rand -base64 32` on the droplet).
POSTGRES_USER=deskia
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=deskia

# DATABASE_URL is consumed by Prisma. Keep user / password / db in sync
# with the POSTGRES_* values above. Host MUST be `db` — that's the
# docker-compose service name inside the private network.
DATABASE_URL=postgresql://deskia:REPLACE_WITH_STRONG_PASSWORD@db:5432/deskia?schema=public

# ── App ────────────────────────────────────────────────────────────────
NODE_ENV=production

# Which business the chat serves. Today single-tenant per deploy.
# When the embed widget lands (next sprint), the chat route resolves
# the business per-request from a slug param and this default is only
# used when no slug is provided.
ACTIVE_BUSINESS_SLUG=dra-sofia-vazquez
