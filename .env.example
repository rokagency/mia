OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini

# DATABASE_URL points to the `db` service inside the docker-compose network.
# If you ever run the Next.js app outside Docker (e.g. `npm run dev` on the
# host) and want to hit the same Postgres, change `db` to `localhost`.
DATABASE_URL=postgresql://deskia:deskia_dev@db:5432/deskia?schema=public
